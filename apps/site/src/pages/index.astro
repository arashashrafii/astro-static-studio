---
import Layout from '../layouts/Layout.astro';
import Projects from '../components/Projects.astro';
import V2PageBlocks from '../components/V2PageBlocks.astro';
import V2CollectionView from '../components/V2CollectionView.astro';
import {content} from '../lib/content';
const data=await content();
const homePage=data.version===2?data.pages.find(page=>page.slug==='home'&&page.published):undefined;
const firstCollection=data.version===2?data.collections[0]:undefined;
const homeCollectionBlock=firstCollection?{type:'collectionView',collectionId:firstCollection.id,view:'grid',categoryIds:[],sort:'manual',limit:12}:undefined;
---
<Layout data={data}>
  {data.version===1?<><section class="hero"><span class="eyebrow">{data.site.name} · PORTFOLIO</span><h1>{data.site.tagline||data.site.name}</h1>{!data.site.tagline&&<p>این صفحهٔ اصلی سایت شماست. عنوان و محتوای سایت را در Studio ویرایش کنید.</p>}</section>{data.entries.some(e=>e.kind==='project'&&e.published)&&<><h2 class="section-title">Selected work</h2><Projects entries={data.entries.filter(e=>e.kind==='project'&&e.published)}/></>}</>:homePage?<><section class="hero"><span class="eyebrow">{data.site.name}</span><h1>{homePage.title}</h1>{homePage.description.source==='manual'&&<p>{homePage.description.value}</p>}</section><V2PageBlocks blocks={homePage.blocks} data={data}/></>:<><section class="hero"><span class="eyebrow">{data.site.name}</span><h1>{data.site.tagline||data.site.name}</h1></section>{firstCollection&&homeCollectionBlock&&<V2CollectionView block={homeCollectionBlock} collection={firstCollection} items={data.items}/>}</>}
</Layout>
