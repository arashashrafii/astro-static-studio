---
import InlineRichText from './InlineRichText.astro';
const {block}=Astro.props;
const align=block.align?`rich-align-${block.align}`:'';
---
{block.type==='heading'?block.level===2?<h2 class:list={['rich-text-block',align]}><InlineRichText nodes={block.content}/></h2>:block.level===3?<h3 class:list={['rich-text-block',align]}><InlineRichText nodes={block.content}/></h3>:<h4 class:list={['rich-text-block',align]}><InlineRichText nodes={block.content}/></h4>:<p class:list={['prose','rich-text-block',align]}><InlineRichText nodes={block.content}/></p>}
