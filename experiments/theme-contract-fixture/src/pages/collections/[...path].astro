---
import Layout from '../../shared/Layout.astro';
import { routes } from '../../shared/route-data';
export function getStaticPaths() { return routes.filter(route => route.data.kind === 'collection').map(route => ({ params: { path: route.path.replace(/^\/collections\//, '').replace(/\/$/, '') }, props: { route } })); }
const { route } = Astro.props;
if (route.data.kind !== 'collection') throw new Error('Expected catalog data.');
---
<Layout data={route.data}><section><p class="kicker">CATALOG · {route.data.page}/{route.data.totalPages}</p><h1>{route.data.title}</h1><ul class="tiles">{route.data.items.map(item => <li><a href={`/items/${item.slug}/`}><img src={item.coverImage?.src} alt={item.coverImage?.alt ?? ''}/><strong>{item.title}</strong></a></li>)}</ul></section></Layout>
