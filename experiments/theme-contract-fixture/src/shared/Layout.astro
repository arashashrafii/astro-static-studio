---
const { data } = Astro.props;
---
<!doctype html><html lang="en" dir="ltr"><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width"/><meta name="description" content={data.description}/><title>{data.title} | {data.siteName}</title></head><body><header><a href="/">{data.siteName}</a><nav aria-label="Main"><a href="/collections/projects/">Projects</a><a href="/content/about/">About</a></nav></header><main><slot/></main><footer>{data.siteName}</footer></body></html>
<style>
  :global(*){box-sizing:border-box}:global(body){margin:0;background:#e9f0f2;color:#18333d;font:17px/1.6 system-ui,sans-serif}:global(header),:global(footer){display:flex;justify-content:space-between;padding:1.5rem 7vw;background:#18333d;color:white}:global(nav){display:flex;gap:1.5rem}:global(a){color:inherit}:global(main){max-width:1050px;margin:auto;padding:4rem 7vw}:global(h1){font-size:clamp(2.5rem,8vw,5rem);line-height:1.05}:global(.feature){padding:2rem 0 4rem}:global(.kicker){text-transform:uppercase;letter-spacing:.15em;font-size:.75rem}:global(.tiles){list-style:none;padding:0;display:grid;grid-template-columns:repeat(auto-fit,minmax(220px,1fr));gap:1.5rem}:global(.tiles img),:global(.cover){width:100%;height:auto;aspect-ratio:4/3;object-fit:cover}:global(.summary){max-width:45rem;color:#395661}@media(max-width:600px){:global(header){display:block}:global(nav){margin-top:1rem}:global(main){padding-top:2rem}}
</style>
