---
const { content, project, rootPath } = Astro.props;
const pageTitle = project ? `${project.title} | ${content.siteTitle}` : content.siteTitle;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <link rel="stylesheet" href={`${rootPath}styles.css`} />
  </head>
  <body>
    <header class="site-header">
      <a href={`${rootPath}index.html`}>{content.siteTitle}</a>
      <span>{content.tagline}</span>
    </header>
    {
      project ? (
        <main class="project-detail">
          <a href={`${rootPath}index.html#work`}>← All projects</a>
          <h1>{project.title}</h1>
          <p>{project.description}</p>
          <img src={`${rootPath}${project.image}`} alt={project.alt} />
        </main>
      ) : (
        <main>
          <section class="intro">
            <p class="eyebrow">Independent artist</p>
            <h1>{content.heading}</h1>
            <p>{content.introduction}</p>
          </section>
          <section id="work" class="work">
            <h2>Selected work</h2>
            <ul>
              {content.projects.map((item) => (
                <li>
                  <a href={`./projects/${item.slug}/index.html`}>
                    <img src={`${rootPath}${item.image}`} alt={item.alt} />
                    <h3>{item.title}</h3>
                    <p>{item.description}</p>
                  </a>
                </li>
              ))}
            </ul>
          </section>
        </main>
      )
    }
    <footer>{content.contact}</footer>
  </body>
</html>
