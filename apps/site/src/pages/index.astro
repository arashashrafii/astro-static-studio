---
import Layout from '../layouts/Layout.astro';
import Projects from '../components/Projects.astro';
import { content } from '../lib/content';
const data=await content();
---
<Layout data={data}><section class="hero"><span class="eyebrow">{data.site.name} · PORTFOLIO</span><h1>{data.site.tagline||data.site.name}</h1>{!data.site.tagline&&<p>این صفحهٔ اصلی سایت شماست. عنوان و محتوای سایت را در Studio ویرایش کنید.</p>}</section>{data.entries.some(e=>e.kind==='project'&&e.published)&&<><h2 class="section-title">Selected work</h2><Projects entries={data.entries.filter(e=>e.kind==='project'&&e.published)}/></>}</Layout>
