---
import Layout from '../../shared/Layout.astro';
import { routes } from '../../shared/route-data';
export function getStaticPaths() { return routes.filter(route => route.data.kind === 'item').map(route => ({ params: { slug: route.path.split('/')[2] }, props: { route } })); }
const { route } = Astro.props;
if (route.data.kind !== 'item') throw new Error('Expected object detail data.');
---
<Layout data={route.data}><article><a href="/collections/projects/">Back to projects</a><h1>{route.data.title}</h1><p class="summary">{route.data.description}</p>{route.data.item.coverImage && <img class="cover" src={route.data.item.coverImage.src} alt={route.data.item.coverImage.alt}/>}<div>{route.data.details}</div></article></Layout>
