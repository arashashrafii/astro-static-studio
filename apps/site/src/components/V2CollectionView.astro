---
import {collectionItemDescription} from '@astro-static-studio/contracts/content-v2';
import V2RichText from './V2RichText.astro';
const {block,collection,items}=Astro.props;
const galleryField=collection?.fields.find((field:any)=>field.type==='gallery');
const richField=collection?.fields.find((field:any)=>field.type==='text'&&field.format==='rich');
const selectedItem=block.itemId&&collection?items.find((item:any)=>item.id===block.itemId&&item.collectionId===collection.id&&item.published):undefined;
const matching=collection?items.filter((item:any)=>item.collectionId===collection.id&&item.published&&(!block.categoryIds.length||((item.values[block.categoryFieldId]??[]) as string[]).some((id:string)=>block.categoryIds.includes(id)))):[];
const ordered=[...matching];
if(block.sort==='title')ordered.sort((a:any,b:any)=>a.title.localeCompare(b.title));
if(block.sort==='newest')ordered.reverse();
const visible=ordered.slice(0,collection?.pageSize??12);
const selectedGalleryImage=collection?.kind==='gallery'&&galleryField&&selectedItem?selectedItem.values[galleryField.id]?.[0]:undefined;
const selectedTitle=selectedItem?.title||selectedGalleryImage?.title||collection?.name;
const selectedRichDoc=richField&&selectedItem?selectedItem.values[richField.id]:undefined;
const selectedHasInlineGallery=selectedRichDoc?.blocks?.some((entry:any)=>entry.type==='gallery')??false;
---
{selectedItem&&collection?<article class="v2-collection-view v2-embedded-item"><div class="v2-collection-heading"><h2>{selectedTitle}</h2><a href={`/${collection.routeBase}/${selectedItem.slug}/`}>مشاهدهٔ جزئیات</a></div>{selectedItem.coverImage&&collection.kind==='content'&&<img class="item-cover" src={selectedItem.coverImage.src} alt={selectedItem.coverImage.alt}/>}{selectedItem.description.source==='manual'&&selectedItem.description.value&&<p class="muted">{collectionItemDescription(collection,selectedItem)}</p>}{collection.fields.map((field:any)=>{const value=selectedItem.values[field.id];if(value===undefined)return null;if(field===richField)return <V2RichText document={value}/>;if(field.type==='gallery')return collection.presetId==='project'&&selectedHasInlineGallery?null:<section class={collection.kind==='gallery'?'gallery-photo-detail':'gallery'}>{value.map((image:any)=><figure><img src={image.src} alt={image.alt}/>{image.title&&<figcaption>{image.title}</figcaption>}</figure>)}</section>;if(field.type==='category'){const names=field.categories.filter((category:any)=>(value as string[]).includes(category.id)).map((category:any)=>category.name);return names.length?<p class="category-list">{names.join(' / ')}</p>:null;}if(field.type==='link')return <p><a href={value.href}>{value.label}</a></p>;if(field.type==='text'&&field.format==='plain'&&field.label.includes('تاریخ'))return <time class="item-date">{value}</time>;return <p class="prose">{value}</p>;})}</article>:collection?<section class:list={['v2-collection-view',`v2-view-${collection.listLayout}`]}><div class="v2-collection-heading"><h2>{collection.name}</h2><a href={`/${collection.slug}/`}>مشاهدهٔ همه</a></div>{visible.length?<div class:list={['v2-collection-items',`v2-view-${collection.listLayout}`,`v2-kind-${collection.kind}`]}>{visible.map((item:any)=>{const image=collection.kind==='gallery'?(galleryField?(item.values[galleryField.id]??[])[0]:undefined):item.coverImage;return <a class="v2-item-card" href={`/${collection.routeBase}/${item.slug}/`}>{image&&<img src={image.src} alt={image.alt}/>}{item.title&&<h3>{item.title}</h3>}{collection.kind==='content'&&<p>{collectionItemDescription(collection,item)}</p>}</a>})}</div>:<p class="muted">هنوز موردی برای نمایش وجود ندارد.</p>}</section>:null}
