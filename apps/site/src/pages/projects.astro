---
import Layout from '../layouts/Layout.astro';
import V2CollectionListing from '../components/V2CollectionListing.astro';
import V2PageBlocks from '../components/V2PageBlocks.astro';
import { descriptionForDisplay } from '@astro-static-studio/contracts/content-v2';
import { content } from '../lib/content';
import { atelierRoutes } from '../lib/theme-routes';
import { projectsIndexView } from '../lib/projects-route';
import type { AtelierRouteData } from '@astro-static-studio/theme/studio/adapter';
const data=await content();
const route=atelierRoutes(data).find(candidate=>candidate.path==='/projects/');
const routeData=route?.data as AtelierRouteData|undefined;
const page=routeData?.resource==='page'?routeData.page:undefined;
const pageDescriptionDocument=page?.blocks.find((block:any)=>block.type==='richText')?.document;
const pageMetaDescription=page?descriptionForDisplay(page.description,pageDescriptionDocument):data.site.tagline;
const view=routeData?.resource==='collection'
  ?{kind:'collection' as const,collection:routeData.collection,items:routeData.content.items}
  :projectsIndexView(data);
const totalPages=view.collection?.loading==='pagination'?Math.max(1,Math.ceil(view.items.filter(item=>item.published).length/view.collection.pageSize)):1;
---
{page
  ?<Layout data={data} title={page.title} description={pageMetaDescription}><span class="eyebrow">PAGE</span><h1>{page.title}</h1>{page.description.source==='manual'&&<p class="muted">{descriptionForDisplay(page.description,pageDescriptionDocument)}</p>}<V2PageBlocks blocks={page.blocks} data={data}/></Layout>
  :<Layout data={data} title={view.collection?.name??'Projects'}><span class="eyebrow">{data.site.name} · PORTFOLIO</span><h1>{view.collection?.name??'Projects'}</h1>{view.collection?<V2CollectionListing collection={view.collection} items={view.items} page={1} totalPages={totalPages}/>:<p>هنوز پروژه‌ای منتشر نشده است.</p>}</Layout>
}

